{
  "name": "@atropical/stroq-studio-mcp",
  "version": "0.1.4",
  "description": "Connects any MCP client (Claude Code, Codex, Cursor, Claude Desktop…) to an open Strōq World Studio tab, over a local WebSocket.",
  "license": "GPL-3.0-only",
  "author": "Atropical",
  "homepage": "https://github.com/atropical/stroq-studio-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atropical/stroq-studio-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/atropical/stroq-studio-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stroq",
    "world-studio",
    "claude",
    "codex",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "stroq-studio-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/relay.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build && npm run type-check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
